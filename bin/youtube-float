#!/usr/bin/env bash
# youtube-float — browse YouTube and play a video in the floating, pinned
# overlay that follows you across every Hyprland workspace.
#
#   youtube-float browse           continue watching, subscriptions, search…
#   youtube-float play <id|url>    play one video
#   youtube-float quality <q>      720 | best | toggle (restarts the video)
#   youtube-float auth             report whether the saved cookies are signed in
#
# Hide/show, resize and close are shared with the other overlays: see
# `float-overlay`.
#
# Search and channel browsing work signed out. The personal sections need
# YouTube cookies in ~/.config/youtube-float/cookies.txt — `auth` explains how.

set -euo pipefail

SELF="$(readlink -f "$0")"
APP_ID="YouTubeFloat"
OVERLAY_APP_NAME="YouTube"
# The overlay picker is this tool's own Omarchy plugin. Absent or
# disabled, the menus fall back to ghostty+fzf.
: "${FLOAT_PICKER_PLUGIN_ID:=io.github.jcputney.media-float-youtube}"
export FLOAT_PICKER_PLUGIN_ID
# shellcheck source=/dev/null
source "$HOME/.local/lib/float-overlay.sh"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/youtube-float"
COOKIES="$CONFIG_DIR/cookies.txt"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/youtube-float"
MENU="$CACHE_DIR/menu.tsv"
QUALITY_FILE="$CONFIG_DIR/quality"

DEFAULT_HEIGHT=720
FEED_LIMIT="${YT_FEED_LIMIT:-40}"
UA="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36"

mkdir -p "$CONFIG_DIR" "$CACHE_DIR"

# ── yt-dlp ──────────────────────────────────────────────────────────────────

ytdl() { # ytdl <url> [extra yt-dlp args…]; echoes the flat-playlist JSON
  local url="$1"; shift
  local jar=()
  if [[ -s $COOKIES ]]; then
    # yt-dlp writes the jar back over the file it is given, and YouTube's
    # session rotation would then invalidate the saved copy. Hand it a throwaway.
    install -m 600 "$COOKIES" "$RUN_DIR/yt-cookies.txt"
    jar=(--cookies "$RUN_DIR/yt-cookies.txt")
  fi
  yt-dlp "${jar[@]}" --flat-playlist --no-warnings --ignore-errors \
    --playlist-end "$FEED_LIMIT" -J "$@" "$url" 2>/dev/null
}

signed_in() {
  [[ -s $COOKIES ]] || return 1
  # grep -q stops at the first match, which closes the pipe and kills curl with
  # SIGPIPE. Under `set -o pipefail` that failure would sink the whole pipeline
  # even though the match succeeded, so report signed out for a signed-in
  # account. Take the pipeline's status from grep alone.
  local ok
  set +o pipefail
  curl -sS --compressed --max-time 30 -b "$COOKIES" -A "$UA" \
    "https://www.youtube.com/feed/subscriptions" 2>/dev/null \
    | grep -qm1 '"LOGGED_IN":true'
  ok=$?
  set -o pipefail
  return "$ok"
}

# ── Rows ────────────────────────────────────────────────────────────────────
# The shared picker wants <display>\t<thumb>\t<info>\t<action>\t<value…>.
# Line breaks inside the info column travel as U+001F: jq's @tsv escapes
# backslashes, so a "\n" would arrive as a literal backslash-n.

JQ_DEFS='
  def clean: (. // "") | gsub("[\t\n\r]"; " ");
  def hms: (. // 0 | floor)
           | if . >= 3600 then ((./3600|floor)|tostring) + "h " + ((./60%60|floor)|tostring) + "m"
             elif . >= 60 then ((./60|floor)|tostring) + "m " + ((.%60)|tostring) + "s"
             else (tostring) + "s" end;
  def compact: if . == null then ""
               elif . >= 1000000 then ((. / 100000 | floor) / 10 | tostring) + "M"
               elif . >= 1000 then ((. / 1000 | floor) | tostring) + "K"
               else (tostring) end;
  def thumb: (.thumbnails // []) | map(select(.url != null)) | (last // {}) | (.url // "-");
'

# A channel's own videos tab leaves the uploader off each entry, because the
# whole tab belongs to one channel; fall back to the tab's own channel name.
# The watch-history feed carries no channel at all — the field is there but
# always null — so those rows are titles only.
JQ_VIDEOS="$JQ_DEFS"'
  . as $feed
  | (($feed.channel // $feed.uploader // "")|clean) as $owner
  | .entries[]? | select(.id != null and (.title // "") != "")
  | ((.channel // .uploader // $owner // "") | clean) as $by
  | [ $prefix + "  " + (.title|clean)
      + (if $by == "" then "" else "   —   " + $by end),
      thumb,
      ( (.title|clean)
        + (if $by == "" then "\u001f" else "\u001f" + $by end)
        + (if .duration then "  ·  " + (.duration|hms) else "" end)
        + (if .view_count then "  ·  " + (.view_count|compact) + " views" else "" end)
        + (if (.live_status // "") == "is_live" then "  ·  LIVE" else "" end)
        + "\u001f\u001f" + (.description|clean) ),
      "play", .id, (.title|clean) ] | @tsv'

JQ_CHANNELS="$JQ_DEFS"'
  .entries[]? | select(.id != null)
  | [ "📺  " + ((.title // .channel // .id)|clean),
      thumb,
      ( ((.title // .channel // .id)|clean)
        + (if .channel_follower_count
           then "\u001f" + (.channel_follower_count|compact) + " subscribers"
           else "" end)
        + "\u001f\u001f" + (.description|clean) ),
      "channel", .id ] | @tsv'

JQ_PLAYLISTS="$JQ_DEFS"'
  .entries[]? | select(.id != null)
  | [ "📂  " + ((.title // .id)|clean),
      thumb,
      ( ((.title // .id)|clean)
        + (if .playlist_count
           then "\u001f" + (.playlist_count|tostring) + " videos"
           else "" end)
        + "\u001f\u001f" + (.description|clean) ),
      "playlist", .id ] | @tsv'

nav_row() { printf '%s\t-\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4"; }

feed_rows() { # feed_rows <url> <jq-program> [row-limit] [row-prefix]
  local url="$1" prog="$2"
  ytdl "$url" ${3:+--playlist-end "$3"} \
    | jq -r --arg prefix "${4:-▸}" "$prog" 2>/dev/null || true
}

# Watch Later first, then whatever you left partway through. YouTube exposes
# neither list without cookies, so both come back empty when signed out.
continue_rows() {
  # Distinct prefixes, because the two lists run together in one flat list and
  # "saved for later" and "already started" are not the same thing.
  feed_rows "https://www.youtube.com/playlist?list=WL" "$JQ_VIDEOS" 15 "⏱"
  feed_rows "https://www.youtube.com/feed/history" "$JQ_VIDEOS" 15 "↺"
}

# ── Menus ───────────────────────────────────────────────────────────────────

tui_main_rows() {
  # Without cookies the personal feeds all come back empty, and asking YouTube
  # for six of them would stall the menu for no reason. Offer the sign-in help
  # instead.
  if [[ -s $COOKIES ]]; then
    continue_rows
    nav_row "📥  Subscriptions"       "Recent uploads from every channel you follow." menu subscriptions
    nav_row "🔥  Recommended for you" "Your YouTube home feed."                       menu recommended
    nav_row "📂  Your playlists"      "Playlists you saved or created."               menu playlists
    nav_row "📺  Your channels"       "Every channel you subscribe to."               menu channels
  else
    nav_row "⚠   Sign in to see your feeds" \
      "Subscriptions, Recommended, Watch Later, history and your playlists all need YouTube cookies. Choose this row to print the steps." \
      signin -
  fi
  # YouTube retired /feed/trending in 2025 and the playlist that replaced it is
  # a frozen 2024 snapshot, so there is no "popular now" row worth showing.
  nav_row "🔍  Search YouTube…"     "Search all of YouTube by keyword. Works signed out." menu search
}

# Each level writes its own rows file, so stepping back re-reads what was
# already fetched instead of pulling the feed again.
menu_file() { printf '%s/menu-%s.tsv' "$CACHE_DIR" "$1"; }

tui_submenu_rows() { # tui_submenu_rows <which>; writes rows to stdout
  case "$1" in
    subscriptions) feed_rows "https://www.youtube.com/feed/subscriptions" "$JQ_VIDEOS" ;;
    recommended)   feed_rows "https://www.youtube.com/feed/recommended"   "$JQ_VIDEOS" ;;
    playlists)     feed_rows "https://www.youtube.com/feed/playlists"     "$JQ_PLAYLISTS" ;;
    channels)      feed_rows "https://www.youtube.com/feed/channels"      "$JQ_CHANNELS" ;;
    search)
      local q; q="$(ask "Search YouTube…")"
      [[ -n $q ]] || return 1
      feed_rows "ytsearch${FEED_LIMIT}:$q" "$JQ_VIDEOS"
      ;;
  esac
}

submenu_label() { # submenu_label <which> [name]
  case "$1" in
    subscriptions) printf 'YouTube · subscriptions' ;;
    recommended)   printf 'YouTube · recommended' ;;
    playlists)     printf 'YouTube · playlists' ;;
    channels)      printf 'YouTube · channels' ;;
    search)        printf 'YouTube · search' ;;
    channel)       printf 'YouTube · %s' "${2:-channel}" ;;
    playlist)      printf 'YouTube · %s' "${2:-playlist}" ;;
    *)             printf 'YouTube' ;;
  esac
}

# The menu is a stack of levels rather than nested calls, so Escape and the
# "← Back" row pop one instead of tearing the whole thing down. Only the top
# level has nowhere above it: Escape closes there.
cmd_browse_tui() {
  local -a labels=()
  local depth picked action value title rows f

  tui_main_rows > "$(menu_file 0)"
  labels=("YouTube")

  while (( ${#labels[@]} > 0 )); do
    depth=$(( ${#labels[@]} - 1 ))
    f="$(menu_file "$depth")"
    [[ -s $f ]] || { unset "labels[$depth]"; continue; }

    if (( depth > 0 )); then
      picked="$(pick "$f" "${labels[$depth]}" back)" || return 1
    else
      picked="$(pick "$f" "${labels[$depth]}")" || return 1
    fi

    if [[ -z $picked ]] || is_back "$picked"; then
      (( depth == 0 )) && return 1
      unset "labels[$depth]"
      continue
    fi

    IFS=$'\t' read -r action value title <<< "$picked"
    case "$action" in
      play)   emit "$value"$'\t'"${title:-YouTube}"; return 0 ;;
      signin) emit "!auth"; return 0 ;;
      menu)
        rows="$(tui_submenu_rows "$value")" || continue
        [[ -n $rows ]] || { emit "!empty $value"; return 1; }
        { back_row; printf '%s\n' "$rows"; } > "$(menu_file $(( depth + 1 )))"
        labels+=("$(submenu_label "$value")")
        ;;
      channel|playlist)
        if [[ $action == channel ]]; then
          rows="$(feed_rows "https://www.youtube.com/channel/$value/videos" "$JQ_VIDEOS")"
        else
          rows="$(feed_rows "https://www.youtube.com/playlist?list=$value" "$JQ_VIDEOS")"
        fi
        [[ -n $rows ]] || continue
        { back_row; printf '%s\n' "$rows"; } > "$(menu_file $(( depth + 1 )))"
        labels+=("$(submenu_label "$action" "${title:-}")")
        ;;
    esac
  done
}

cmd_browse() {
  local picked id title
  picked="$(run_menu "$SELF _browse_tui")"
  [[ -n $picked ]] || exit 0

  [[ $picked == "!auth" ]] && { cmd_auth; exit 0; }

  # An empty personal feed nearly always means the cookies are not signed in.
  if [[ $picked == '!empty '* ]]; then
    case "${picked#!empty }" in
      search) die "Nothing came back for that." ;;
      *) die "That section is empty — run 'youtube-float auth' to check your sign-in." ;;
    esac
  fi

  IFS=$'\t' read -r id title <<< "$picked"
  [[ -n $id ]] || exit 0
  stop_existing
  setsid -f "$0" _session "$id" "${title:-YouTube}" >> "$LOG" 2>&1
  note "Opening ${title:-that video}…"
}

# ── Playback ────────────────────────────────────────────────────────────────

height() { cat "$QUALITY_FILE" 2>/dev/null || echo "$DEFAULT_HEIGHT"; }

ytdl_format() {
  local h; h="$(height)"
  if [[ $h == "best" ]]; then
    printf '%s' "bestvideo+bestaudio/best"
  else
    printf 'bestvideo[height<=?%s]+bestaudio/best[height<=?%s]/best' "$h" "$h"
  fi
}

cmd_session() { # cmd_session <video-id> <title>
  local id="$1" title="${2:-YouTube}" mpv_pid raw=()
  echo "$$" > "$PID_FILE"
  # setsid gives this session its own process group, so killing the group on the
  # way out takes yt-dlp's downloader with it.
  trap 'trap - EXIT; rm -f "$PID_FILE"; kill -- "-$$" 2>/dev/null || true' EXIT

  if [[ -s $COOKIES ]]; then
    install -m 600 "$COOKIES" "$RUN_DIR/yt-cookies-play.txt"
    raw=(--ytdl-raw-options="cookies=$RUN_DIR/yt-cookies-play.txt")
  fi

  overlay_mpv_args "$APP_ID" "$title"
  rm -f "$SOCKET"

  mpv "${OVERLAY_MPV_ARGS[@]}" --ytdl-format="$(ytdl_format)" "${raw[@]}" \
    "https://www.youtube.com/watch?v=$id" >/dev/null 2>&1 &
  mpv_pid=$!

  overlay_apply_size_when_ready
  wait "$mpv_pid" || true
}

video_id() { # video_id <id|url>
  local in="$1"
  if [[ $in =~ ^[A-Za-z0-9_-]{11}$ ]]; then printf '%s' "$in"; return; fi
  printf '%s' "$in" | sed -n \
    -e 's#.*[?&]v=\([A-Za-z0-9_-]\{11\}\).*#\1#p' \
    -e 's#.*youtu\.be/\([A-Za-z0-9_-]\{11\}\).*#\1#p' \
    -e 's#.*/shorts/\([A-Za-z0-9_-]\{11\}\).*#\1#p' | head -1
}

cmd_play() { # cmd_play <id|url>
  local id; id="$(video_id "${1:?video id or URL required}")"
  [[ -n $id ]] || die "Could not read a video id out of that"
  stop_existing
  setsid -f "$0" _session "$id" "YouTube" >> "$LOG" 2>&1
}

cmd_quality() { # cmd_quality <720|best|toggle>
  local want="${1:-toggle}" cur; cur="$(height)"
  [[ $want == "toggle" ]] && { [[ $cur == "best" ]] && want="$DEFAULT_HEIGHT" || want="best"; }
  printf '%s\n' "$want" > "$QUALITY_FILE"
  note "YouTube quality: $([[ $want == best ]] && echo "source" || echo "${want}p")"

  # Only restart if this overlay is the one playing.
  [[ "$(overlay_field .class)" == "$APP_ID" ]] || return 0
  local url id; url="$(mpv_get path)"
  [[ -n $url && $url != null ]] || return 0
  id="$(video_id "$url")"
  [[ -n $id ]] || return 0
  stop_existing
  setsid -f "$0" _session "$id" "YouTube" >> "$LOG" 2>&1
}

# ── Guided sign-in ──────────────────────────────────────────────────────────
# YouTube has no OAuth route to your subscriptions, Watch Later or history --
# Google removed API access to them in 2016 -- so the personal feeds need
# cookies from a signed-in session. Rather than walk people through a cookie
# extension, drive a browser profile that exists only for this.
#
# The profile is the point. YouTube rotates the session of a browser you keep
# using, which silently invalidates any cookies exported from it; a profile that
# is never browsed in again keeps its session. It also means refreshing cookies
# later needs no new sign-in.
#
# Your password is typed into a real browser. This tool never sees it.
PROFILE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/youtube-float/browser"

# Chromium reads its cookie key from the system keyring by default, which drags
# in python-secretstorage and fails without a running keyring. --password-store=
# basic uses the built-in key instead, which yt-dlp can decrypt unaided.
browser_backend() { # echoes "<yt-dlp name>\t<binary>\t<chromium|firefox>"
  local desktop bin
  desktop="$(env -u BROWSER xdg-settings get default-web-browser 2>/dev/null)"
  case "$desktop" in
    firefox*)            bin=firefox;               set -- firefox  "$bin" firefox  ;;
    chromium*)           bin=chromium;              set -- chromium "$bin" chromium ;;
    *google-chrome*)     bin=google-chrome-stable;  set -- chrome   "$bin" chromium ;;
    brave*)              bin=brave;                 set -- brave    "$bin" chromium ;;
    vivaldi*)            bin=vivaldi;               set -- vivaldi  "$bin" chromium ;;
    *)                   set -- "" "" "" ;;
  esac
  if [[ -n ${2:-} ]] && command -v "$2" >/dev/null 2>&1; then
    printf '%s\t%s\t%s\n' "$1" "$2" "$3"; return 0
  fi
  # The default is unsupported or missing; take whatever is installed.
  if command -v chromium >/dev/null 2>&1; then
    printf 'chromium\tchromium\tchromium\n'; return 0
  fi
  if command -v firefox >/dev/null 2>&1; then
    printf 'firefox\tfirefox\tfirefox\n'; return 0
  fi
  return 1
}

guided_auth() {
  local ytname bin kind
  IFS=$'\t' read -r ytname bin kind < <(browser_backend) || return 1
  [[ -n ${ytname:-} ]] || return 1

  # The profile holds a live YouTube session, so it is as sensitive as the
  # cookie jar it produces.
  ( umask 077; mkdir -p "$PROFILE_DIR" )

  cat <<EOF

Opening $bin with a browser profile used only by youtube-float.

  1. Sign in to YouTube in the window that opens.
  2. Close the window. Do NOT sign out.

Waiting for the browser to close…
EOF

  local db
  if [[ $kind == firefox ]]; then
    db="$PROFILE_DIR/cookies.sqlite"
    "$bin" -no-remote -profile "$PROFILE_DIR" https://www.youtube.com >/dev/null 2>&1 || true
  else
    db="$PROFILE_DIR/Default/Cookies"
    "$bin" --user-data-dir="$PROFILE_DIR" --password-store=basic \
           --no-first-run --no-default-browser-check \
           https://www.youtube.com >/dev/null 2>&1 || true
  fi

  # Do not trust the launcher to block. Chromium in particular can hand off to a
  # helper and return long before the window opens, which would have us export
  # from a profile the browser has not written yet. Wait for the browser to
  # actually be gone, then for its cookie store to exist and stop growing.
  local i
  for (( i = 0; i < 1800; i++ )); do
    pgrep -f -- "$PROFILE_DIR" >/dev/null 2>&1 || break
    sleep 1
  done
  local size=0 prev=-1
  for (( i = 0; i < 30; i++ )); do
    size=$(stat -c %s "$db" 2>/dev/null || echo 0)
    (( size > 0 && size == prev )) && break
    prev=$size
    sleep 1
  done
  if (( size == 0 )); then
    printf 'The browser closed without leaving a cookie store.\n'
    printf 'It may not have finished starting. Try again.\n'
    return 1
  fi

  printf 'Exporting cookies…\n'
  local jar; jar="$(mktemp "$RUN_DIR/yt-export.XXXXXX")"
  printf '# Netscape HTTP Cookie File\n' > "$jar"
  local yterr="$RUN_DIR/yt-export.err"
  ( umask 077
    yt-dlp --cookies-from-browser "$ytname:$PROFILE_DIR" --cookies "$jar" \
           --skip-download --playlist-items 0 --ignore-no-formats-error \
           --no-warnings \
           "https://www.youtube.com/feed/subscriptions" >"$yterr" 2>&1 ) || true
  if [[ ! -s $jar ]]; then
    rm -f "$jar"
    printf 'No cookies came back from %s. yt-dlp said:\n' "$bin"
    sed 's/^/    /' "$yterr" 2>/dev/null | tail -5
    return 1
  fi

  if COOKIES="$jar" signed_in; then
    ( umask 077; mkdir -p "$(dirname "$COOKIES")" )
    mv "$jar" "$COOKIES"
    chmod 600 "$COOKIES"
    note "YouTube: signed in."
    printf 'Signed in. Subscriptions, Watch Later and history are available.\n'
    printf 'Renew later with `youtube-float auth --refresh`; the profile is kept,\n'
    printf 'so it will not ask you to sign in again unless the session expires.\n'
    return 0
  fi

  rm -f "$jar"
  printf 'Cookies came back, but they are not signed in.\n'
  printf 'Sign in inside that browser window before closing it, then try again.\n'
  printf 'Your existing cookies.txt was left alone.\n'
  return 1
}

cmd_auth() { # cmd_auth [--manual|--refresh]
  # --refresh forces the browser flow even when the current cookies still work,
  # which is the only way to renew a session before it lapses.
  if [[ ${1:-} == "--refresh" ]]; then
    guided_auth && return 0
    printf 'Refresh failed. Your existing cookies.txt is unchanged.\n'
    return 1
  fi
  if [[ ${1:-} != "--manual" && -s $COOKIES ]] && signed_in; then
    note "YouTube: signed in."
    printf 'Signed in. The personal feeds are available.\n'
    printf 'To renew the session: youtube-float auth --refresh\n'
    return 0
  fi
  note "YouTube cookies are not signed in."

  # Drive a browser if we can. Only fall through to the hand instructions when
  # there is no browser to drive, or the guided run did not get us signed in.
  if [[ ${1:-} != "--manual" ]] && guided_auth; then
    return 0
  fi

  cat <<'EOF'

Doing it by hand instead. Search and channel browsing still work without this.

To enable Subscriptions, Recommended, Watch Later, history and your playlists,
export cookies from a PRIVATE window. YouTube rotates the session of a browser
you are actively using, which invalidates any cookies exported from it. A
private window you never sign out of keeps its session frozen instead.

  1. Open a private/incognito window and sign in to YouTube.
  2. In that same window open https://www.youtube.com/robots.txt
     (this stops the session rotating while you export).
  3. Export cookies for youtube.com with a cookies.txt browser extension.
  4. Save it as ~/.config/youtube-float/cookies.txt, then:
        chmod 600 ~/.config/youtube-float/cookies.txt
  5. Close the private window WITHOUT signing out.
  6. Run: youtube-float auth
EOF
}

case "${1:-browse}" in
  browse)      cmd_browse ;;
  _browse_tui) cmd_browse_tui ;;
  _preview)    shift || true; render_preview "${1:--}" "${2:--}" ;;
  play)        shift; cmd_play "${1:?video id or URL required}" ;;
  quality)     shift || true; cmd_quality "${1:-toggle}" ;;
  auth)        shift || true; cmd_auth "${1:-}" ;;
  toggle)      cmd_toggle ;;
  quit)        cmd_quit ;;
  size)        shift || true; cmd_size "${1:-cycle}" ;;
  _session)    shift; cmd_session "$1" "${2:-YouTube}" ;;
  *)           die "Unknown command: $1 (browse|play|quality|auth [--refresh|--manual]|toggle|quit|size)" ;;
esac
